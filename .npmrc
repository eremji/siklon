engine-strict=true
# N'installer que des versions publiées depuis au moins 3 jours : une version piégée est en
# général retirée du registre avant (npm >= 11.10). Même valeur que semver-patch-days de
# Dependabot, pour qu'un correctif qu'il propose reste installable.
# Correctif de sécurité urgent plus récent : npm install <paquet>@<version> --min-release-age=0
min-release-age=3
