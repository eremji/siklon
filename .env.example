# Variables d'environnement de Siklon. Copier en .env.local et compléter ; ne jamais committer de valeur.

# Tests e2e uniquement : « 1 » fait lire à la page des fixtures locales au lieu du flux NHC.
# Ignorée sur Vercel. Ne jamais la définir en production.
NHC_FIXTURES=

# Clé de l'API Vigilance Météo-France (portail-api.meteofrance.fr), lue côté serveur uniquement.
METEOFRANCE_API_KEY=

# Chaîne de connexion Postgres (Supabase, pooler en mode session) : rôle siklon_lecture pour le site,
# siklon_import pour `npm run import:hurdat2`. Une base distante est toujours jointe en TLS avec
# vérification du certificat ; les paramètres ssl* de la chaîne sont ignorés. Seule une base locale
# (localhost) peut se passer de TLS.
DATABASE_URL=

# Certificat racine Supabase (contenu PEM, « Supabase Root 2021 CA ») : obligatoire sur Vercel.
# En local, on peut à la place ajouter ?sslrootcert=<chemin du certificat> à DATABASE_URL.
DATABASE_CA_CERT=

# Comptes (US-05) : chaîne de connexion avec le rôle siklon_comptes (mêmes règles TLS que DATABASE_URL).
DATABASE_URL_COMPTES=

# Secret de Better Auth (signature des sessions) : au moins 32 caractères aléatoires, différent pour
# chaque environnement (local, preview, production). Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publique du site, sans barre finale (ex. https://siklon.example). Obligatoire en production ;
# en développement, http://localhost:3000 par défaut.
BETTER_AUTH_URL=
