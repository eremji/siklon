# Variables d'environnement de Siklon. Copier en .env.local et compléter ; ne jamais committer de valeur.

# Tests e2e uniquement : « 1 » fait lire à la page des fixtures locales au lieu du flux NHC.
# Ignorée sur Vercel. Ne jamais la définir en production.
NHC_FIXTURES=

# Clé de l'API Vigilance Météo-France (portail-api.meteofrance.fr), lue côté serveur uniquement.
METEOFRANCE_API_KEY=

# Chaîne de connexion Postgres (Supabase, pooler en mode session) : rôle siklon_lecture pour le site,
# siklon_import pour `npm run import:hurdat2`. Une base distante est toujours jointe en TLS avec
# vérification du certificat ; les paramètres ssl* de la chaîne sont ignorés. Seule une base locale
# (localhost) peut se passer de TLS.
DATABASE_URL=

# Certificat racine Supabase (contenu PEM, « Supabase Root 2021 CA ») : obligatoire sur Vercel.
# En local, on peut à la place ajouter ?sslrootcert=<chemin du certificat> à DATABASE_URL.
DATABASE_CA_CERT=

# Comptes (US-05) : chaîne de connexion avec le rôle siklon_comptes (mêmes règles TLS que DATABASE_URL).
DATABASE_URL_COMPTES=

# Secret de Better Auth (signature des sessions) : au moins 32 caractères aléatoires, différent pour
# chaque environnement (local, preview, production). Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publique du site, sans barre finale (ex. https://siklon.example). Obligatoire en production ;
# en développement, http://localhost:3000 par défaut.
BETTER_AUTH_URL=

# Clé de l'API Brevo (emails de confirmation et de réinitialisation, effacement à la suppression du
# compte). Obligatoire en production ; en développement sans clé, les emails s'affichent dans le terminal.
BREVO_API_KEY=

# Client OAuth de Google (console Google Cloud, « Identifiants »), adresse de redirection autorisée :
# <BETTER_AUTH_URL>/api/auth/callback/google. Les deux ou aucun : sans eux, pas de bouton Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tests e2e uniquement : dossier où écrire les emails au lieu de les envoyer. Ignorée sur Vercel.
EMAILS_DOSSIER=

# Web push (US-07) : clés VAPID, générées une fois pour chaque environnement avec
# `npx web-push generate-vapid-keys`. La clé publique est donnée au navigateur à l'abonnement ; la clé
# privée signe les envois et reste côté serveur. Sans ces trois variables, le bouton des alertes sur
# appareil annonce qu'elles ne sont pas encore disponibles. Changer de clés désabonne tous les appareils.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services push : mailto:<adresse> ou https://<site>.
VAPID_SUBJECT=

# Vérification planifiée des alertes (US-07) : secret partagé avec la tâche pg_cron de Supabase, qui
# appelle POST /api/alertes/verifier chaque minute avec « Authorization: Bearer <secret> ». Au moins
# 32 caractères ; la même valeur va dans le Vault de Supabase (siklon_alertes_secret, voir
# supabase/migrations/20261121000000_planification_alertes.sql). Générer avec : openssl rand -base64 32
ALERTES_CRON_SECRET=
